	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.660487613110-mf4qoet2e6ac1s7ov18m4h1e98n4bq4a</string>
			</array>
		</dict>
	</array>
